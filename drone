#include <SoftwareSerial.h>

SoftwareSerial bleSerial(A0, A1); // RX, TX (조종기 쉴드 BLE 핀)

// ==== 드론 제어 기본 변수 ====
unsigned char startBit_1 = 0x26;
unsigned char startBit_2 = 0xa8;
unsigned char startBit_3 = 0x14;
unsigned char startBit_4 = 0xb1;
unsigned char len        = 0x14;
unsigned char checkSum   = 0;

int roll     = 0;
int pitch    = 0;
int yaw      = 0;
int throttle = 0;
int option   = 0x000f;

int p_vel = 0x0064;
int y_vel = 0x0064;
unsigned char drone_action = 0;
unsigned char payload[14];
unsigned int firstRoll;
unsigned int firstPitch;

// ==== AI 기억장치 변수 ====
int  ai_pitch    = 0;
int  ai_roll     = 0;
bool ai_led      = false;

// ==== AI 명령 유지 타이머 ====
unsigned long cmdReceivedAt = 0;
#define CMD_HOLD_MS 800

//-----------------------------------------------------

void checkThrottle() {
  if(!digitalRead(6))      { if(throttle > 9)   throttle -= 10; }
  else if(!digitalRead(5)) { if(throttle < 141)  throttle += 20; }
}

void checkYaw() {
  if(throttle == 0) yaw = 0;
  if(!digitalRead(7))      { if(yaw > -170) yaw -= 10; }
  else if(!digitalRead(8)) { if(yaw < 170)  yaw += 10; }
}

void checkEmergency() {
  if(!digitalRead(9)) {
    roll = 0; pitch = 0; yaw = 0; throttle = 0; option = 0x000e;
    // 비상 시 AI 기억 전부 초기화
    ai_pitch = 0; ai_roll = 0;
  } else {
    option = ai_led ? 0x001f : 0x000f;
  }
}

void checkRoll() {
  unsigned int secondRoll = analogRead(4);
  if     (secondRoll < firstRoll - 450) roll = -200;
  else if(secondRoll < firstRoll - 350) roll = -160;
  else if(secondRoll < firstRoll - 250) roll = -120;
  else if(secondRoll < firstRoll - 150) roll = -80;
  else if(secondRoll < firstRoll - 80)  roll = -40;  // ★ 데드존 확대
  else if(secondRoll < firstRoll + 80)  roll = 0;    // ★ 데드존 확대
  else if(secondRoll < firstRoll + 150) roll = 40;
  else if(secondRoll < firstRoll + 250) roll = 80;
  else if(secondRoll < firstRoll + 350) roll = 120;
  else if(secondRoll < firstRoll + 450) roll = 160;
  else                                   roll = 200;
}

void checkPitch() {
  unsigned int secondPitch = analogRead(5);
  if     (secondPitch < firstPitch - 450) pitch = -200;
  else if(secondPitch < firstPitch - 350) pitch = -160;
  else if(secondPitch < firstPitch - 250) pitch = -120;
  else if(secondPitch < firstPitch - 150) pitch = -80;
  else if(secondPitch < firstPitch - 80)  pitch = -40;  // ★ 데드존 확대
  else if(secondPitch < firstPitch + 80)  pitch = 0;    // ★ 데드존 확대
  else if(secondPitch < firstPitch + 150) pitch = 40;
  else if(secondPitch < firstPitch + 250) pitch = 80;
  else if(secondPitch < firstPitch + 350) pitch = 120;
  else if(secondPitch < firstPitch + 450) pitch = 160;
  else                                     pitch = 200;
}

void sendDroneCommand() {
  bleSerial.print("at+writeh000d");
  bleSerial.print(String(startBit_1, HEX));
  bleSerial.print(String(startBit_2, HEX));
  bleSerial.print(String(startBit_3, HEX));
  bleSerial.print(String(startBit_4, HEX));
  bleSerial.print(String(len, HEX));

  if(checkSum < 0x10) bleSerial.print("0" + String(checkSum, HEX));
  else                 bleSerial.print(String(checkSum, HEX));

  for(int i = 0; i < 14; i++) {
    if(payload[i] < 0x10) bleSerial.print("0" + String(payload[i], HEX));
    else                   bleSerial.print(String(payload[i], HEX));
  }
  bleSerial.print("\r");
  delay(50);
}

void checkCRC() {
  memset(payload, 0x00, 14);
  payload[0]  = (roll)     & 0x00ff;  payload[1]  = (roll     >> 8) & 0x00ff;
  payload[2]  = (pitch)    & 0x00ff;  payload[3]  = (pitch    >> 8) & 0x00ff;
  payload[4]  = (yaw)      & 0x00ff;  payload[5]  = (yaw      >> 8) & 0x00ff;
  payload[6]  = (throttle) & 0x00ff;  payload[7]  = (throttle >> 8) & 0x00ff;
  payload[8]  = (option)   & 0x00ff;  payload[9]  = (option   >> 8) & 0x00ff;
  payload[10] = (p_vel)    & 0x00ff;  payload[11] = (p_vel    >> 8) & 0x00ff;
  payload[12] = (y_vel)    & 0x00ff;  payload[13] = (y_vel    >> 8) & 0x00ff;

  checkSum = 0;
  for(int i = 0; i < 14; i++) checkSum += payload[i];
  checkSum = checkSum & 0x00ff;
}

// ★ 캘리브레이션: 20번 평균값으로 기준점 설정
unsigned char startDroneControl() {
  if(!digitalRead(9)) {
    long sumRoll = 0, sumPitch = 0;
    for(int i = 0; i < 20; i++) {
      sumRoll  += analogRead(4);
      sumPitch += analogRead(5);
      delay(5);
    }
    firstRoll  = sumRoll  / 20;
    firstPitch = sumPitch / 20;

    Serial.print("캘리브레이션 완료 - Roll 기준: ");
    Serial.print(firstRoll);
    Serial.print(" / Pitch 기준: ");
    Serial.println(firstPitch);

    drone_action = 1;
  }
  return drone_action;
}

void setup() {
  Serial.begin(9600);
  bleSerial.begin(9600);

  for(int i = 5; i < 11; i++) {
    pinMode(i, INPUT);
    digitalWrite(i, HIGH);
  }
  delay(500);
  Serial.println("시스템 준비 완료. 9번 버튼을 눌러 캘리브레이션 시작");
}

//-----------------------------------------------------
void loop() {
  if(startDroneControl()) {

    // ── 1. 수동 조이스틱 입력 읽기 ──────────────────────
    checkThrottle();
    checkRoll();
    checkPitch();
    checkYaw();
    checkEmergency();

    // ── 2. 수동 조작 여부 판별 (±40 이하는 오차로 무시) ──
    bool isManualOverride = (abs(roll) > 40 || abs(pitch) > 40);

    // ── 3. AI 명령 수신 ──────────────────────────────────
    if (Serial.available() > 0) {
      char aiCommand = Serial.read();
      cmdReceivedAt = millis();

      switch(aiCommand) {
        case 'F':
          ai_pitch = 100;
          ai_roll  = 0;
          Serial.println("ACK:F");
          break;

        case 'B':
          ai_pitch = -100;
          ai_roll  = 0;
          Serial.println("ACK:B");
          break;

        case 'U':
          // ★ 상승 시 pitch/roll 완전 고정
          ai_pitch = 0;
          ai_roll  = 0;
          pitch    = 0;
          roll     = 0;
          if(throttle < 121) throttle += 30;
          Serial.println("ACK:U");
          break;

        case 'G':
          // ★ 착륙 시 pitch/roll 완전 고정
          ai_pitch = 0;
          ai_roll  = 0;
          pitch    = 0;
          roll     = 0;
          if(throttle > 0) throttle -= 10;
          Serial.println("ACK:G");
          break;

        case 'S':
          ai_pitch = 0;
          ai_roll  = 0;
          Serial.println("ACK:S");
          break;

        case 'O':
          ai_led = true;
          Serial.println("ACK:O");
          break;

        case 'X':
          ai_led = false;
          Serial.println("ACK:X");
          break;
      }
    }

    // ── 4. 명령 유지 시간 초과 시 수평이동 자동 정지 ────
    if(millis() - cmdReceivedAt > CMD_HOLD_MS) {
      ai_pitch = 0;
      ai_roll  = 0;
    }

    // ── 5. 권한 중재: 수동 vs AI ────────────────────────
    if (isManualOverride) {
      // 사람이 조이스틱 조작 시 AI 기억 즉시 초기화
      ai_pitch = 0;
      ai_roll  = 0;
    } else {
      // 조이스틱 중립 → AI 기억값 적용
      pitch = ai_pitch;
      roll  = ai_roll;
    }

    // ── 6. 최종 패킷 전송 ───────────────────────────────
    checkCRC();
    sendDroneCommand();
  }
}
