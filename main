#!/usr/bin/env python3
"""
욘두 드론 AI 지상 통제소
명령어: 전진(F) / 후진(B) / 상승(U) / 하강(G) / 자동임무(M)
"""

import subprocess
import json
import sys
import serial
import serial.tools.list_ports
import time
import threading
from vosk import Model, KaldiRecognizer

# ==========================================
# 1. 아두이노 시리얼 연결 (포트 자동 탐지)
# ==========================================
def find_arduino():
    for port in serial.tools.list_ports.comports():
        if any(k in (port.description or "") for k in ["Arduino", "CH340", "CP210"]):
            print(f"[자동탐지] 아두이노 발견: {port.device}")
            return port.device
    candidates = ["/dev/ttyACM0", "/dev/ttyACM1", "/dev/ttyUSB0", "/dev/ttyUSB1"]
    for candidate in candidates:
        try:
            s = serial.Serial(candidate, 9600, timeout=0.1)
            s.close()
            print(f"[포트] 사용 가능한 포트: {candidate}")
            return candidate
        except:
            continue
    return "/dev/ttyACM0"

print("아두이노와 연결을 시도합니다...")
try:
    port = find_arduino()
    arduino = serial.Serial(port, 9600, timeout=1)
    time.sleep(2)
    print(f"✅ 아두이노 연결 성공! ({port})")
except Exception as e:
    print(f"❌ 아두이노 연결 실패: {e}")
    sys.exit(1)


# ==========================================
# 2. 자동 임무 시간 설정값
# ==========================================
TAKEOFF_TIME  = 3.0   # 이륙 대기 시간 (초) — 드론이 충분히 뜰 때까지
FORWARD_TIME  = 2.0   # 전진 시간 (초) — 길수록 더 멀리 이동
HOVER_TIME    = 1.0   # 목적지 도착 후 정지 대기 시간 (초)
LANDING_COUNT = 5     # 착륙 명령 반복 횟수
LANDING_DELAY = 0.5   # 착륙 명령 간격 (초)

# 자동 임무 실행 중 여부 (중복 실행 방지)
mission_running = False


# ==========================================
# 3. 명령어 사전
# ==========================================
WAKE_WORDS = [
    # 정확한 발음
    "욘두",
    # Vosk 오인식 패턴
    "연두", "용두", "윤두", "년두",
    "욘 두", "용 두", "연 두",
    "온두", "원두", "욘드", "용드",
    "룐두", "논두", "몬두", "존두", "콘두",
    "욘두야", "욘두아", "욘두어",
    "온드", "완두", "욘도", "용도",
    "윤도", "연도", "욘디", "용디",
    "욘두가", "욘두는",
    "요두", "욘듀", "욘뚜",
]

CMD_FORWARD = [
    # 정확한 발음
    "전진", "전진해", "전진해라", "전진하라",
    # Vosk 오인식 패턴
    "전 진", "전지", "전직", "전짐", "전딘",
    "철진", "전진이", "전진을",
    "전긴", "전긴해", "전기",
    "점진", "점진해",
    "전찐", "전찌", "전쪽",
    "전신", "전씬", "전씽",
    "진진", "젠진", "전징",
    "전딘", "전띤", "전뚱",
    "전닌", "전닝", "전딩",
]

CMD_BACKWARD = [
    # 정확한 발음
    "후진", "후진해", "후진해라", "후진하라",
    # Vosk 오인식 패턴
    "후 진", "후지", "후직", "후짐",
    "후긴", "후긴해", "후기",
    "후찐", "후찌", "후쪽",
    "후신", "후씬", "후씽",
    "후딘", "후띤", "후뚱",
    "후징", "후쟁", "후쟁해",
    "후닌", "후닝", "후딩",
    "우진", "우직", "우짐",
    "훗진", "훗직", "훗짐",
    "후전", "후점", "후젠",
]

CMD_TAKEOFF = [
    # 정확한 발음
    "상승", "상승해", "상승해라", "상승하라",
    # Vosk 오인식 패턴
    "상순", "상수", "상슨", "상슴", "상슬",
    "쌍승", "쌍순", "샹승", "상으", "상응",
    "상숭", "상쑹", "상싱", "상성",
    "상승이", "상승을", "상승은",
    "상 승", "상스", "상슈",
    "상진", "상신", "상선",
    "쌍슨", "쌍슴",
    "상숭", "상쑹", "상씽",
    "샹순", "샹슨", "샹슴",
]

CMD_LAND = [
    # 정확한 발음
    "하강", "하강해", "하강해라", "하강하라",
    # Vosk 오인식 패턴
    "하 강", "하갈", "하깡", "하간",
    "하강이", "하강을", "하강은",
    "아강", "아갈", "아깡",
    "하가", "하각", "하감",
    "하낭", "하당", "하방",
    "강하", "강하해", "강하해라",
    "하항", "하앙", "하양",
    "하캉", "하칸", "하칭",
    "하깡", "하껑", "하꽝",
    "하광", "하관", "하갱",
]

CMD_MISSION = [
    # 자동 임무 호출어
    "자동", "자동 임무", "미션", "임무 시작",
    "자율 비행", "자동 비행", "출동",
    "갔다 와", "갔다와", "다녀와",
    "자동으로", "자율로", "알아서",
    "임무", "작전", "작전 시작",
    "고고", "출발 자동", "자동 출발",
    "자동이", "자동을", "자동은",
    "미션 시작", "미션이", "미션을",
]

# (전송코드, 설명, 키워드 리스트)
COMMANDS = [
    ('F', "전진",    CMD_FORWARD),
    ('B', "후진",    CMD_BACKWARD),
    ('U', "상승",    CMD_TAKEOFF),
    ('G', "하강",    CMD_LAND),
    ('M', "자동임무", CMD_MISSION),
]


# ==========================================
# 4. 자동 임무 함수
# ==========================================
def auto_mission():
    global mission_running

    if mission_running:
        print("   ⚠️  이미 자동 임무 실행 중입니다.")
        return

    mission_running = True
    print("\n" + "="*40)
    print("🚀 자동 임무 시작!")
    print("="*40)

    try:
        # 1단계: 이륙
        print("[1단계] 🛫 이륙 중...")
        for _ in range(3):
            arduino.write(b'U')
            time.sleep(0.5)
        time.sleep(TAKEOFF_TIME)
        print(f"        이륙 완료 ({TAKEOFF_TIME}초)")

        # 2단계: 전진
        print("[2단계] ➡️  전진 중...")
        arduino.write(b'F')
        time.sleep(FORWARD_TIME)
        print(f"        전진 완료 ({FORWARD_TIME}초)")

        # 3단계: 정지 호버링
        print("[3단계] ⏸️  정지 중...")
        arduino.write(b'S')
        time.sleep(HOVER_TIME)
        print(f"        정지 완료 ({HOVER_TIME}초)")

        # 4단계: 착륙
        print("[4단계] 🛬 착륙 중...")
        for i in range(LANDING_COUNT):
            arduino.write(b'G')
            time.sleep(LANDING_DELAY)
            print(f"        착륙 명령 {i+1}/{LANDING_COUNT}")

        print("="*40)
        print("✅ 자동 임무 완료!")
        print("="*40 + "\n")

    except Exception as e:
        print(f"[자동임무 오류] {e}")

    finally:
        mission_running = False


# ==========================================
# 5. 명령 전송 함수 (ACK 확인 포함)
# ==========================================
last_command      = None
last_command_time = 0
COMMAND_COOLDOWN  = 1.5  # 동일 명령 연속 방지 (초)

def send_command(code: str, description: str):
    global last_command, last_command_time

    # 자동 임무는 별도 처리
    if code == 'M':
        t = threading.Thread(target=auto_mission)
        t.daemon = True
        t.start()
        return True

    # 자동 임무 실행 중에는 수동 명령 차단
    if mission_running:
        print("   🔒 자동 임무 실행 중 — 수동 명령 차단됨")
        return False

    # 중복 명령 방지
    now = time.time()
    if code == last_command and (now - last_command_time) < COMMAND_COOLDOWN:
        print(f"   ⏱️  중복 명령 무시 ({description})")
        return False

    arduino.write(code.encode())
    last_command      = code
    last_command_time = now
    print(f"   📤 전송: '{code}' ({description})")

    # ACK 대기 (최대 300ms)
    deadline = time.time() + 0.3
    while time.time() < deadline:
        if arduino.in_waiting:
            ack = arduino.readline().decode(errors='ignore').strip()
            if ack.startswith("ACK"):
                print(f"   ✅ 수신 확인: {ack}")
                return True
    print(f"   ⚠️  ACK 없음")
    return False


# ==========================================
# 6. 명령 분석 및 실행 함수
# ==========================================
def analyze_and_execute(text: str, from_partial: bool = False):
    # 호출어 확인
    if not any(wake in text for wake in WAKE_WORDS):
        return

    print(f"\n🎯 호출어 감지! 전체 문장: '{text}'")

    matched = False
    for code, desc, keywords in COMMANDS:
        if any(kw in text for kw in keywords):
            send_command(code, desc)
            matched = True
            break

    if not matched:
        print("   ❓ 명령을 알아듣지 못했습니다.")
        print("   💡 사용 가능: 전진 / 후진 / 상승 / 하강 / 자동임무")


# ==========================================
# 7. Vosk 모델 로드
# ==========================================
print("\nVosk 한국어 모델 로딩 중...")
try:
    model = Model("model")
    print("✅ 모델 로드 완료!")
except Exception as e:
    print(f"❌ 모델 로드 실패: {e}")
    print("   'model' 폴더가 스크립트와 같은 위치에 있는지 확인하세요.")
    sys.exit(1)

rec = KaldiRecognizer(model, 16000)
rec.SetMaxAlternatives(3)
rec.SetWords(True)


# ==========================================
# 8. 마이크 장치 확인
# ==========================================
def check_mic_devices():
    try:
        result = subprocess.run(["arecord", "-l"], capture_output=True, text=True)
        print("\n[마이크 목록]")
        for line in result.stdout.split('\n'):
            if 'card' in line.lower() or '카드' in line:
                print(f"  {line}")
    except:
        pass

check_mic_devices()

MIC_DEVICE = "plughw:0,0"  # 마이크 카드 번호

arecord_cmd = [
    "arecord",
    "-D", MIC_DEVICE,
    "-f", "S16_LE",
    "-c", "1",
    "-r", "16000",
    "-t", "raw",
    "-q",
    "--buffer-size=4096"
]

print("\n" + "="*45)
print("🎙️  욘두 AI 지상 통제소 가동!")
print("="*45)
print("사용법: '욘두 [명령어]'")
print("명령어: 전진 / 후진 / 상승 / 하강")
print("        자동임무 (이륙→전진→착륙 자동 수행)")
print(f"자동임무 설정: 이륙 {TAKEOFF_TIME}초 / "
      f"전진 {FORWARD_TIME}초 / "
      f"착륙 {LANDING_COUNT}회")
print("종료: Ctrl+C")
print("="*45 + "\n")


# ==========================================
# 9. 메인 루프
# ==========================================
last_executed_text = ""  # 중복 실행 방지

try:
    process = subprocess.Popen(arecord_cmd, stdout=subprocess.PIPE)

    while True:
        data = process.stdout.read(4000)
        if len(data) == 0:
            print("[오류] 마이크 스트림이 끊어졌습니다.")
            break

        if rec.AcceptWaveform(data):
            # 문장 완성 → 최종 처리
            result = json.loads(rec.Result())
            text   = result.get('text', '').strip()
            if text:
                print(f"\n[인식 완료]: '{text}'")
                last_executed_text = ""
                analyze_and_execute(text, from_partial=False)
        else:
            # 부분 인식 → 호출어 + 명령어 모두 감지 시 즉시 실행
            partial = json.loads(rec.PartialResult())
            p_text  = partial.get('partial', '').strip()
            if p_text:
                print(f"   (듣는 중... {p_text})", end='\r')

                has_wake = any(w in p_text for w in WAKE_WORDS)
                has_cmd  = any(
                    kw in p_text
                    for _, _, kws in COMMANDS
                    for kw in kws
                )

                if has_wake and has_cmd and p_text != last_executed_text:
                    last_executed_text = p_text
                    print(f"\n[부분인식 실행]: '{p_text}'")
                    analyze_and_execute(p_text, from_partial=True)

except KeyboardInterrupt:
    print("\n\n[시스템] 정상 종료합니다.")
except Exception as e:
    print(f"\n[오류] {e}")
finally:
    try:
        process.kill()
    except:
        pass
    arduino.close()
    print("[시스템] 연결 해제 완료.")
