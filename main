#!/usr/bin/env python3
"""
욘두 드론 AI 지상 통제소
명령어: 전진(F) / 후진(B) / 상승(U) / 착륙(G)
"""

import subprocess
import json
import sys
import serial
import serial.tools.list_ports
import time
from vosk import Model, KaldiRecognizer

# ==========================================
# 1. 아두이노 시리얼 연결 (포트 자동 탐지)
# ==========================================
def find_arduino():
    for port in serial.tools.list_ports.comports():
        if any(k in (port.description or "") for k in ["Arduino", "CH340", "CP210"]):
            print(f"[자동탐지] 아두이노 발견: {port.device}")
            return port.device
    candidates = ["/dev/ttyACM0", "/dev/ttyACM1", "/dev/ttyUSB0", "/dev/ttyUSB1"]
    for candidate in candidates:
        try:
            s = serial.Serial(candidate, 9600, timeout=0.1)
            s.close()
            print(f"[포트] 사용 가능한 포트: {candidate}")
            return candidate
        except:
            continue
    return "/dev/ttyACM0"

print("아두이노와 연결을 시도합니다...")
try:
    port = find_arduino()
    arduino = serial.Serial(port, 9600, timeout=1)
    time.sleep(2)
    print(f"✅ 아두이노 연결 성공! ({port})")
except Exception as e:
    print(f"❌ 아두이노 연결 실패: {e}")
    sys.exit(1)


# ==========================================
# 2. 명령어 사전 (4가지 + 유사어 최대 확장)
# ==========================================
WAKE_WORDS = [
    "욘두",
    "연두", "용두", "윤두", "년두", "욘 두", "용 두",
    "온두", "원두", "욘드", "용드", "온드",
    "룐두", "논두", "몬두", "존두", "콘두",
    "욘두야", "욘두아", "욘두어",
]

CMD_FORWARD = [
    "전진", "앞으로", "앞으로 가", "앞으로 가라", "앞으로 이동",
    "전진해", "전진해라", "전진하라", "전진 해",
    "출발", "출발해", "출발해라", "출발하라",
    "가", "가라", "가자", "가줘", "가세요",
    "앞", "앞가", "앞으",
    "포워드", "전방", "전방으로", "직진", "직진해",
    "앞으로 나아가", "나아가", "전진 명령",
    "전 진", "압으로", "압프로", "안으로",
    "철진", "전지", "전직", "전짐",
    "출 발", "철발", "출밥",
    "까", "카", "가가",
]

CMD_BACKWARD = [
    "후진", "뒤로", "뒤로 가", "뒤로 가라", "뒤로 이동",
    "후진해", "후진해라", "후진하라", "후진 해",
    "뒤", "뒤가", "뒤로 물러", "물러나", "물러나라",
    "후퇴", "후퇴해", "후퇴해라", "후퇴하라",
    "백", "백으로", "뒤쪽", "뒤쪽으로",
    "돌아가", "돌아와", "되돌아가",
    "뒤로 나아가", "후방", "후방으로",
    "후 진", "뒤 로", "후지", "후직",
    "뒤료", "뒤루", "뒤르",
    "빽", "벡",
]

CMD_TAKEOFF = [
    "상승", "상승해", "상승해라", "상승하라", "상승 해",
    "이륙", "이륙해", "이륙해라", "이륙하라", "이륙 해",
    "위로", "위로 가", "위로 가라", "위로 올라가",
    "올라가", "올라가라", "올라가줘", "올라와",
    "올라", "올라라", "날아", "날아가", "날아올라",
    "떠", "떠라", "떠올라", "뜨자", "뜨라",
    "위", "위가", "위쪽", "위쪽으로",
    "업", "높이", "높이 올라",
    "날자", "날아라", "비상", "비상해",
    "하늘로", "하늘로 가", "공중으로",
    "부양", "부양해", "부양하라",
    "상 승", "이 륙", "상슬", "상슴",
    "이리", "이른", "이르",
    "위료", "위루", "올라까",
    "날라",
]

CMD_LAND = [
    "착륙", "착륙해", "착륙해라", "착륙하라", "착륙 해",
    "내려", "내려와", "내려가", "내려가라", "내려앉아",
    "내려라", "내려와라", "내려오라",
    "착지", "착지해", "착지해라", "착지하라",
    "내려앉아라", "앉아", "앉아라",
    "하강", "하강해", "하강해라", "하강하라",
    "아래로", "아래로 가", "아래로 내려",
    "아래", "아래가", "아래쪽", "아래쪽으로",
    "다운", "다운해", "랜딩", "랜딩해",
    "땅으로", "땅으로 가", "땅에 내려",
    "돌아와", "복귀", "복귀해", "귀환", "귀환해",
    "착 륙", "착르", "착릭",
    "내 려", "내류",
    "하 강", "하갈", "하깡",
    "아래료", "아래루",
    "당으로", "담으로",
]

# (전송코드, 설명, 키워드 리스트)
COMMANDS = [
    ('F', "전진", CMD_FORWARD),
    ('B', "후진", CMD_BACKWARD),
    ('U', "상승", CMD_TAKEOFF),
    ('G', "착륙", CMD_LAND),
]


# ==========================================
# 3. 명령 전송 함수 (ACK 확인 포함)
# ==========================================
last_command = None
last_command_time = 0
COMMAND_COOLDOWN = 1.5  # 동일 명령 연속 방지 (초)

def send_command(code: str, description: str):
    global last_command, last_command_time

    # 동일 명령 연속 방지
    now = time.time()
    if code == last_command and (now - last_command_time) < COMMAND_COOLDOWN:
        print(f"   ⏱️  중복 명령 무시 ({description})")
        return False

    arduino.write(code.encode())
    last_command = code
    last_command_time = now
    print(f"   📤 전송: '{code}' ({description})")

    # ACK 대기 (최대 300ms)
    deadline = time.time() + 0.3
    while time.time() < deadline:
        if arduino.in_waiting:
            ack = arduino.readline().decode(errors='ignore').strip()
            if ack.startswith("ACK"):
                print(f"   ✅ 수신 확인: {ack}")
                return True
    print(f"   ⚠️  ACK 없음")
    return False


# ==========================================
# 4. 명령 분석 및 실행 함수
# ==========================================
partial_executed = False  # partial 중복 실행 방지

def analyze_and_execute(text: str, from_partial: bool = False):
    global partial_executed

    # 호출어 확인
    if not any(wake in text for wake in WAKE_WORDS):
        return

    # partial 중복 방지
    if from_partial:
        if partial_executed:
            return
    else:
        partial_executed = False  # 최종 결과면 초기화

    print(f"\n🎯 호출어 감지! 전체 문장: '{text}'")

    matched = False
    for code, desc, keywords in COMMANDS:
        if any(kw in text for kw in keywords):
            send_command(code, desc)
            matched = True
            if from_partial:
                partial_executed = True
            break

    if not matched:
        print("   ❓ 명령을 알아듣지 못했습니다.")
        print("   💡 사용 가능: 전진 / 후진 / 상승 / 착륙")


# ==========================================
# 5. Vosk 모델 로드
# ==========================================
print("\nVosk 한국어 모델 로딩 중...")
try:
    model = Model("model")
    print("✅ 모델 로드 완료!")
except Exception as e:
    print(f"❌ 모델 로드 실패: {e}")
    print("   'model' 폴더가 스크립트와 같은 위치에 있는지 확인하세요.")
    sys.exit(1)

rec = KaldiRecognizer(model, 16000)
rec.SetMaxAlternatives(3)
rec.SetWords(True)


# ==========================================
# 6. 마이크 장치 확인
# ==========================================
def check_mic_devices():
    try:
        result = subprocess.run(["arecord", "-l"], capture_output=True, text=True)
        print("\n[마이크 목록]")
        for line in result.stdout.split('\n'):
            if 'card' in line.lower() or '카드' in line:
                print(f"  {line}")
    except:
        pass

check_mic_devices()

MIC_DEVICE = "plughw:0,0"  # 마이크 카드 번호 (arecord -l 결과 기준)

arecord_cmd = [
    "arecord",
    "-D", MIC_DEVICE,
    "-f", "S16_LE",
    "-c", "1",
    "-r", "16000",
    "-t", "raw",
    "-q",
    "--buffer-size=4096"
]

print("\n" + "="*45)
print("🎙️  욘두 AI 지상 통제소 가동!")
print("="*45)
print("사용법: '욘두 [명령어]'")
print("명령어: 전진 / 후진 / 상승 / 착륙")
print("종료: Ctrl+C")
print("="*45 + "\n")


# ==========================================
# 7. 메인 루프
# ==========================================
try:
    process = subprocess.Popen(arecord_cmd, stdout=subprocess.PIPE)

    while True:
        data = process.stdout.read(4000)
        if len(data) == 0:
            print("[오류] 마이크 스트림이 끊어졌습니다.")
            break

        if rec.AcceptWaveform(data):
            # 문장 완성 → 최종 처리
            result = json.loads(rec.Result())
            text = result.get('text', '').strip()
            if text:
                analyze_and_execute(text, from_partial=False)
        else:
            # 부분 인식 → 빠른 반응
            partial = json.loads(rec.PartialResult())
            p_text = partial.get('partial', '').strip()
            if p_text:
                print(f"   (듣는 중... {p_text})", end='\r')
                analyze_and_execute(p_text, from_partial=True)

except KeyboardInterrupt:
    print("\n\n[시스템] 정상 종료합니다.")
except Exception as e:
    print(f"\n[오류] {e}")
finally:
    try:
        process.kill()
    except:
        pass
    arduino.close()
    print("[시스템] 연결 해제 완료.")
